# multi-agent-handoff demo — copy to .env (gitignored). LANGFUSE_* is read ONLY from this
# file, never from the shell (a shell-exported key for another project hijacks traces).

# Langfuse project for this demo (Cloud by default; or the repo's self-hosted stack).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL=http://localhost:3001

ANTHROPIC_API_KEY=sk-ant-...

# Optional
# HANDOFF_ENVIRONMENT=production
# HANDOFF_RELEASE=1.0.0
# HANDOFF_PROMPT_LABEL=production
# HANDOFF_ROUTER_MODEL=claude-haiku-5-5
# HANDOFF_SPECIALIST_MODEL=claude-sonnet-5-5
# BILLING_PORT=9310
# TECH_SUPPORT_PORT=9311
# HANDOFF_CAPTURE_DIR=/tmp/handoff-spans   # write spans to JSONL instead of Langfuse (offline)
# HANDOFF_JUDGE_PROVIDER=Anthropic          # the LLM connection's NAME for the judges (case-sensitive)
# HANDOFF_A2A_TIMEOUT_S=120                 # how long a handoff waits for a remote agent

# Fault switches (SPEC §10), normally set per command, not here:
# HANDOFF_SLIM_CONTEXT=1                    # F2: drop line_id from handoff payloads
# BILLING_FAULT_LATENCY_MS=8000             # F5: slow billing service (set when starting the services)
# BILLING_URL=http://127.0.0.1:9            # F5: billing unreachable
