# Copy this file to .env (gitignored) and fill in the blanks. LANGFUSE_* is read ONLY from
# that file, never from the shell: a shell-exported key for another project would send the
# traces there. Every other variable can also be set in the shell for one command.

# --- Langfuse: the project this demo writes to (multi-agent-handoff, on Langfuse Cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL=http://localhost:3001     # a self-hosted server instead; it must support SDK v5 (SPEC §14)

# --- Model provider: the agents and the simulated customer
ANTHROPIC_API_KEY=

# --- Optional: models, prompt label, trace attributes (the defaults are shown)
# HANDOFF_ROUTER_MODEL=claude-haiku-5-5       # the concierge
# HANDOFF_SPECIALIST_MODEL=claude-sonnet-5-5  # tech-support, billing, and the single-agent baseline
# HANDOFF_SIMULATOR_MODEL=claude-haiku-5-5    # the simulated customer
# HANDOFF_PROMPT_LABEL=production
# HANDOFF_ENVIRONMENT=production
# HANDOFF_RELEASE=1.0.0
# HANDOFF_JUDGE_PROVIDER=Anthropic            # the LLM connection's NAME for the judges (case-sensitive)

# --- Optional: the A2A services and the back office (the defaults are shown)
# HANDOFF_HOST=127.0.0.1
# BILLING_PORT=9310
# TECH_SUPPORT_PORT=9311
# BILLING_URL=http://127.0.0.1:9310           # default: built from the host and port
# TECH_SUPPORT_URL=http://127.0.0.1:9311
# HANDOFF_A2A_TIMEOUT_S=120                   # how long a handoff waits for a remote agent
# HANDOFF_MAX_HANDOFFS=4                      # the hop cap for one turn
# HANDOFF_LEDGER=.run/ledger.sqlite           # default: that file in this folder

# --- Optional: run offline
# HANDOFF_CAPTURE_DIR=/tmp/handoff-spans      # write spans to JSONL files instead of Langfuse
# HANDOFF_OFFLINE_PROMPTS=1                   # use the prompt texts in the code, not Langfuse
# HANDOFF_TRUST_SHELL_KEYS=1                  # read LANGFUSE_* from the shell, as CI does

# --- Fault switches (SPEC §10), normally set per command, not here
# HANDOFF_SLIM_CONTEXT=1                      # F2: drop line_id from handoff payloads (shell only)
# BILLING_FAULT_LATENCY_MS=8000               # F5: slow billing service (set when starting the services)
# TECH_SUPPORT_FAULT_LATENCY_MS=8000          # F5: slow tech-support service
# BILLING_URL=http://127.0.0.1:9              # F5: billing unreachable
