# Do not copy this file to .env: nothing in this demo reads a .env. Copy org.env.example to private/org.env instead.
#
# This file is the index of every variable the demo reads, grouped by the file that holds it.
# Values that are secrets stay blank here and live only in private/ (gitignored, files mode 0600,
# directory mode 0700). Python never reads them: paths are handed to the Langfuse CLI
# (scripts/langfuse-connect.sh --env-file) or to Node (node --env-file scripts/platform-api.mjs).
# Shell-exported LANGFUSE_* keys are ignored: the CLI's --env file wins, and verify/seed strip them.

# --- private/org.env -------------------------------------------------------------------------
# Template: org.env.example. Create with: python3 scripts/seed_all.py (copies it, mode 0600).
# An ORGANIZATION-scoped key (Organization settings > API keys). A project key gets HTTP 403.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=http://localhost:3001      # informational: workflows.py fixes HOST to this URL

# --- private/instance.env (only for the Organizations workflow) ------------------------------
# Template: instance.env.example (comments only; the root compose loads it while the API is off).
# Create with: python3 scripts/prepare-instance-key.py   (refuses to overwrite)
# Load into langfuse-web with: ./scripts/enable-instance-api.sh --dry-run, then without --dry-run
# ADMIN_API_KEY=

# --- repo-root .env (read by the root docker-compose.yaml for langfuse-web) ------------------
# LANGFUSE_INSTANCE_ENV_FILE=./demos/langfuse-enterprise-operations/private/instance.env

# --- written by the portal; never edit ---------------------------------------------------------
# private/keys/<projectId>-<keyId>.env   LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_BASE_URL
# private/personas/<role>-<tag>.env      DEMO_EMAIL, DEMO_PASSWORD (synthetic native sign-in personas)

# --- optional, for scripts/verify_demo.py --------------------------------------------------------
# Organization name the org key should belong to; defaults to langfuse.project in demo.yaml.
# DEMO_LANGFUSE_PROJECT=Demo Organization

# --- optional, for the Langfuse CLI wrapper ----------------------------------------------------
# Runner override, e.g. "langfuse" or "npx --yes @langfuse/cli@1". Default: global CLI, then npx, then bunx.
# LANGFUSE_CLI_BIN=
