# Northwind Bank demo — copy to .env. Demo-only values; never reuse in production.
# ── Platform (docker-compose.yml) ──
ENCRYPTION_KEY=            # openssl rand -hex 32
NEXTAUTH_SECRET=northwind-nextauth-secret
SALT=northwind-demo-salt
LANGFUSE_VERSION=4.53.0
# Enterprise license: leave empty here; scripts/up.sh reads it from the repo-root .env
LANGFUSE_EE_LICENSE_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@northwind.example
LANGFUSE_INIT_USER_PASSWORD=northwind-demo-1

# ── App → Langfuse ──
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-northwind-retail
LANGFUSE_SECRET_KEY=sk-lf-northwind-retail
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_MASK_PII=true

# ── App → APM (Dynatrace stand-in = local Jaeger) ──
APM_OTLP_ENDPOINT=http://localhost:14318/v1/traces
APM_OTLP_HEADERS=
APM_UI_TRACE_URL=http://localhost:16686/trace/{trace_id}
# Dynatrace: APM_OTLP_ENDPOINT=https://<env-id>.live.dynatrace.com/api/v2/otlp/v1/traces
#            APM_OTLP_HEADERS=Authorization=Api-Token <token with openTelemetryTrace.ingest>
#            APM_UI_TRACE_URL=https://<env-id>.apps.dynatrace.com/ui/apps/dynatrace.distributedtracing/explorer?traceId={trace_id}

# ── Models ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-sonnet-4-6
MCP_URL=http://localhost:8765/mcp

# ── Low-code: n8n → Langfuse (OBS-02) — written by scripts/setup_n8n.sh ──
N8N_OTEL_ENABLED=true
N8N_OTEL_EXPORTER_OTLP_ENDPOINT=            # <LANGFUSE_BASE_URL>/api/public/otel
N8N_OTEL_EXPORTER_OTLP_HEADERS=             # Authorization=Basic <base64 pk:sk>,x-langfuse-ingestion-version=4
N8N_OWNER_EMAIL=owner@northwind.example
N8N_OWNER_PASSWORD=                         # generated on first run
