# Marketing agent debugging workshop — environment template.
# Copy to `.env` (gitignored). scripts/provision_cloud.py writes the Langfuse lines for you
# from an organization API key in `.env.cloud-org` (also gitignored).

# Langfuse Cloud project for this demo (US region shown; EU is https://cloud.langfuse.com)
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PROJECT_NAME=marketing-agent-debugging
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Claude — the agent and its fact-checker
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# FACTCHECK_MODEL=claude-opus-5-5
# AGENT_MAX_STEPS=10
# AGENT_FALLBACKS=default          # server-side refusal fallback (Claude API beta); "off" to disable
# LANGFUSE_TRACING_ENVIRONMENT=production   # use `development` for rehearsal runs
