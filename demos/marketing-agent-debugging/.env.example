# Copy this file to `.env` (gitignored) and fill in the blanks. scripts/provision_cloud.py
# can write the Langfuse lines for you from an organization API key in `.env.cloud-org`
# (also gitignored). Values here override shell-exported LANGFUSE_* keys.

# --- Langfuse Cloud project for this demo (US region shown; EU is https://cloud.langfuse.com)
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PROJECT_NAME=marketing-agent-debugging
LANGFUSE_PROJECT_ID=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Claude: the agent, its fact-checker, and the key the two LLM judges are stored with
ANTHROPIC_API_KEY=

# --- Optional overrides (defaults shown)
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# FACTCHECK_MODEL=claude-opus-5-5
# AGENT_MAX_STEPS=10
# AGENT_FALLBACKS=default          # server-side refusal fallback (Claude API beta); "off" to disable
# JUDGE_MODEL=claude-opus-5-5      # model for the two LLM judges (scripts/seed_evaluators.py)

# Do NOT set LANGFUSE_TRACING_ENVIRONMENT here: it would override the shell value that
# rehearsal runs use (LANGFUSE_TRACING_ENVIRONMENT=development .venv/bin/python scripts/run_agent.py ...).
