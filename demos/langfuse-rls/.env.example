# Copy this file to .env and fill in the keys: cp .env.example .env
# The seeder and the readiness check read only this file; shell-exported LANGFUSE_* are ignored.
# `npm run dev` (Next.js) lets shell exports win, so unset them before starting the app.

# --- Langfuse (the self-hosted stack from the repo root, langfuse profile) ---
# Create a project in your local Langfuse at http://localhost:3001 and grab keys from
# Project Settings -> API Keys. LANGFUSE_HOST is accepted as a fallback for LANGFUSE_BASE_URL.
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The name of that project. scripts/verify.sh checks the keys map to it
# (falls back to langfuse.project in demo.yaml).
LANGFUSE_PROJECT_NAME=RLS Demo

# --- Readiness check (optional) ---
# Where scripts/verify.sh finds the running app (default http://localhost:3000).
# DEMO_APP_URL=http://localhost:3000
