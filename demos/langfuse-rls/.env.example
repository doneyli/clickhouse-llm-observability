# Langfuse connection — primary var is LANGFUSE_BASE_URL; LANGFUSE_HOST is also accepted as fallback.
# Create a project in your local Langfuse at http://localhost:3001 and grab keys from
# Project Settings -> API Keys.
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Optional: used in the seeder to tag traces with the project name
LANGFUSE_PROJECT_NAME=RLS Demo
