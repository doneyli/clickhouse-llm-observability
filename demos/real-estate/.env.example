# Real Estate Property Concierge demo — environment template.
# Copy to `.env` (gitignored) and fill in. All keys are read by agent/config.py.

# Langfuse project the demo targets (create a project named "real-estate").
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Langfuse Cloud is the DEFAULT for this demo (US region shown; EU is
# https://cloud.langfuse.com), using that project's API keys (Settings > API Keys).
# Cloud is REQUIRED for the GitHub Actions prompt-CI gate — a GitHub runner cannot
# reach a localhost Langfuse. See cicd/README.md.
#
# To run against the self-hosted stack instead, swap the line below for
# http://localhost:3001 and use the self-hosted project's keys. Everything works the
# same on both, including managed LLM-as-a-Judge evaluators
# (seed_managed_evaluators.sh DB-seeds them self-hosted and creates them via the
# evaluation-rules API on Cloud) — but the CI gate will not work from a runner.
#
# Either backend is fine for the SDK: this demo uses Langfuse Python SDK v4, which
# supports self-hosted servers >= 3.63.0 (this repo's stack runs 3.221.1).
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Only if your (Cloud) project is NOT named "real-estate":
# LANGFUSE_PROJECT_NAME=my-project-name

# Optional: ALSO send every trace (live, portal and experiment spans) to a
# second Langfuse — e.g. self-hosted primary + Langfuse Cloud mirror. Same
# trace ids land on both. Live/portal scores are duplicated too; experiment
# evaluation scores, prompts, datasets and managed evaluators stay
# primary-only. Read from this file only (shell exports are ignored).
# LANGFUSE_MIRROR_PUBLIC_KEY=pk-lf-...
# LANGFUSE_MIRROR_SECRET_KEY=sk-lf-...
# LANGFUSE_MIRROR_HOST=https://us.cloud.langfuse.com

# PII redaction — ON unless explicitly disabled. Emails, phone numbers, IBANs,
# Spanish NIE/DNI numbers and card numbers are scrubbed out of span payloads
# INSIDE this process, so they never reach Langfuse at all (agent/masking.py;
# proved end-to-end by scripts/verify_masking.py).
#
# Leave this commented OUT rather than setting it to true: .env overrides the
# shell, so a value here would block the one-line comparison the demo relies on
#   LANGFUSE_MASK_PII=false ./.venv/bin/python scripts/run_live_traffic.py
# which exports the same query unredacted for a side-by-side.
#
# Mirroring and masking are mutually exclusive — the mirror is a separate OTLP
# exporter that the masking hook cannot reach, so the demo refuses to start with
# both on rather than ship unredacted spans to the mirror.
# LANGFUSE_MASK_PII=false

# Anthropic — agent + LLM-as-a-Judge.
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-sonnet-4-6

# OpenAI — only needed to run the agent on GPT for the Claude-vs-GPT comparison.
# (Either OPENAI_API_KEY or OPEN_AI_API_KEY is accepted.)
OPEN_AI_API_KEY=sk-proj-...
OPENAI_AGENT_MODEL=gpt-4o

# Which prompt version the PORTAL serves. Defaults to `production`, i.e. the
# portal behaves exactly like the deployed agent. Set it to `first-draft` only to
# STAGE a demo artifact — a genuinely bad answer you can thumb down, so a
# walkthrough can open on a real user complaint. The portal prints the served
# label on startup and warns when it is not production; put it back before you
# present.
# PORTAL_PROMPT_LABEL=first-draft
