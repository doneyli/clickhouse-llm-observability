# Copy this file to .env (gitignored) and fill in the blanks, or let
# ./scripts/provision-project.sh write .env for you on the self-hosted stack (it never
# overwrites an existing .env; it prints the lines to add instead).
# src/env.ts and scripts/verify_demo.ts load this folder's .env with override, so a
# shell-exported LANGFUSE_* key for another project cannot hijack the demo.

# --- Langfuse: the project this demo writes to (grocery-assistant)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted stack from the repo root; for Langfuse Cloud use https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=http://localhost:3001
# src/env.ts refuses to run unless the keys resolve to a project with this name
LANGFUSE_PROJECT_NAME=grocery-assistant

# --- Models: the assistant, and the judge (src/evaluators/judge.ts)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-sonnet-4-6

# --- Optional: readiness check only
# Project name scripts/verify_demo.ts expects; defaults to LANGFUSE_PROJECT_NAME, then demo.yaml
# DEMO_LANGFUSE_PROJECT=

# --- Read from the shell by scripts/provision-project.sh, not from this file
# GROCERY_PROJECT_NAME=grocery-assistant
# LANGFUSE_POSTGRES_CONTAINER=langfuse-postgres
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_SALT=   (must match SALT in the repo root docker-compose.yaml)
