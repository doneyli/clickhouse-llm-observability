# Copy to .env (gitignored) and fill in. The demo loads .env with override=True, so a
# shell-exported LANGFUSE_* key for another project can't hijack its traces.

# --- ClickHouse Cloud: the agent's connection (read-only user created by scripts/load_data.py)
CH_HOST=<your-service>.<region>.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=scenario_agent
CH_PASSWORD=<generate: python -c 'import secrets;print(secrets.token_urlsafe(24))'>
CH_DATABASE=flights
CH_TABLE=ontime

# --- ClickHouse Cloud: admin, used ONLY by scripts/load_data.py (data load + user creation)
CH_ADMIN_USER=default
CH_ADMIN_PASSWORD=

# Rehearse without a Cloud service: EXPLORER_TARGET=playground points the agent at the
# same data on ClickHouse's public playground. Smoke tests only — the playground's demo
# user allows 20 runs per query shape per hour, so a real sweep hits its quota.
# EXPLORER_TARGET=playground

# --- Anthropic
ANTHROPIC_API_KEY=
# EXPLORER_MODEL=claude-opus-5-5
# EXPLORER_EFFORT=medium
# EXPLORER_PROMPT_LABEL=production

# --- Langfuse Cloud project for this demo
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
