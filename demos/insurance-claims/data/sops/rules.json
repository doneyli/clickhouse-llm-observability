  {
   "rule_id": "ALL-DOC-001",
   "type": "DOC_REQUIRED",
   "severity": "major",
   "title": "Death certificate missing or uncertified",
   "condition": {
    "any": [
     {
      "fact": "death_certificate_present",
      "op": "false",
      "value": null
     },
     {
      "fact": "death_certificate_certified",
      "op": "false",
      "value": null
     }
    ]
   },
   "version": 1,
   "effective_from": "2024-01-01",
   "effective_to": null,
   "supersedes": [],
   "letter": false,
   "params": {},
   "effect": "hold",
   "lines": [
    "individual_life",
    "group_life",
    "annuity_death"
   ],
   "states": [
    "ALL"
   ],
   "action": "Pend; request a certified copy of the death certificate",
   "sop_id": "SOP-ALL-01",
   "section": "2"
  },
  {
