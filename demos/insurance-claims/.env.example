# Northwind Life & Annuity claims demo — copy to .env. Demo-only values.
# Target: CLAIMS_PROFILE=cloud (default when .env.cloud exists) or selfhosted (.env.selfhosted).
# The profile overlay holds LANGFUSE_BASE_URL / LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY / LANGFUSE_PROJECT_ID;
# scripts/provision_cloud.py writes .env.cloud from an organization key in .env.cloud-org.
CLAIMS_PROFILE=
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_MASK_PII=true
CLAIMS_RELEASE=claims-1.5.0

# ── Models (keys may also come from the repo-root .env) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
INTAKE_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-sonnet-4-6

# ── Services ──
CLAIMS_MCP_PORT=8767
DOC_INTAKE_PORT=9210
CLAIMS_PORTAL_PORT=8095

# ── APM (Dynatrace stand-in = local Jaeger; "off" disables the APM copy) ──
APM_OTLP_ENDPOINT=http://localhost:14318/v1/traces
APM_OTLP_HEADERS=
APM_UI_TRACE_URL=http://localhost:16686/trace/{trace_id}
# Dynatrace: APM_OTLP_ENDPOINT=https://<env-id>.live.dynatrace.com/api/v2/otlp/v1/traces
#            APM_OTLP_HEADERS=Authorization=Api-Token <token with openTelemetryTrace.ingest>

# ── Self-hosted Enterprise stack (docker compose --profile selfhosted) — generate, never reuse ──
ENCRYPTION_KEY=            # openssl rand -hex 32
NEXTAUTH_SECRET=
SALT=
LANGFUSE_INIT_USER_EMAIL=platform.admin@northwind-life.example
LANGFUSE_INIT_USER_PASSWORD=
SELFHOSTED_PUBLIC_KEY=
SELFHOSTED_SECRET_KEY=
DEMO_USER_PASSWORD=          # RBAC demo users (letters, digits AND a special character)
