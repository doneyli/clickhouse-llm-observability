# ===========================================================================
# Brand Promo Multi-Agent Demo — Credentials Template
# ===========================================================================
# Copy this file to .env and fill in. .env is gitignored.
# ===========================================================================

# Anthropic API key for all LLM calls (orchestrator, crews, compliance, judge).
ANTHROPIC_API_KEY=""

# Langfuse credentials. The implementer can fetch the project keys via the
# Langfuse admin API after creating the project, OR you can paste them after
# creating the project manually in the UI.
LANGFUSE_HOST="http://localhost:3001"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""

# Langfuse admin token used ONCE to create the project via API.
# Generate this in Langfuse UI under Settings -> Organizations -> API Keys
# (or Personal Access Token if your Langfuse build exposes it). Optional;
# if absent the implementer will fall back to a manual setup step.
LANGFUSE_ADMIN_TOKEN=""

# LLM observability backend. Langfuse is the only supported backend.
BACKEND="langfuse"

# Optional: real market-research tool. If absent, the market tool returns
# canned synthetic results so the demo still works offline.
TAVILY_API_KEY=""
