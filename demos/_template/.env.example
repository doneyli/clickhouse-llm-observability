# Copy this file to .env (gitignored) and fill in the blanks. The demo's scripts read .env
# and ignore shell-exported LANGFUSE_* keys, so a key for another project cannot hijack it.

# --- Langfuse: the project this demo writes to ({{PROJECT}})
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL={{BASE_URL}}

# --- Model provider
ANTHROPIC_API_KEY=
