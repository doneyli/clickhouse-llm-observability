# Real Estate Property Concierge demo — environment template.
# Copy to `.env` (gitignored) and fill in. All keys are read by agent/config.py.

# Langfuse project the demo targets (create a project named "real-estate").
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3001

# Anthropic — agent + LLM-as-a-Judge.
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-sonnet-4-6

# OpenAI — only needed to run the agent on GPT for the Claude-vs-GPT comparison.
# (Either OPENAI_API_KEY or OPEN_AI_API_KEY is accepted.)
OPEN_AI_API_KEY=sk-proj-...
OPENAI_AGENT_MODEL=gpt-4o
