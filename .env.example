# ==============================================================================
# LLM Observability Demo - Environment Configuration
# ==============================================================================
#
# Quick Start:
#   1. Copy this file: cp .env.example .env
#   2. Add your ANTHROPIC_API_KEY below
#   3. Run: ./scripts/setup.sh
#
# The setup script will:
#   - Auto-generate LibreChat secrets
#   - Guide you through ClickStack and Langfuse account setup
#   - Save all credentials to .env
#
# ==============================================================================

# ==============================================================================
# REQUIRED - Must be set before running ./scripts/setup.sh
# ==============================================================================

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ==============================================================================
# AUTO-GENERATED - Created by ./scripts/setup.sh
# ==============================================================================
# These values are generated automatically during setup.
# Only set manually if you need specific values.

# ClickStack API Key (obtained from http://localhost:8080 -> Team Settings)
# CLICKSTACK_API_KEY=

# LibreChat Secrets (auto-generated with openssl)
# CREDS_KEY=
# CREDS_IV=
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# Langfuse API Keys (obtained from http://localhost:3001 -> Settings -> API Keys)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_MCP_AUTH_TOKEN=

# ==============================================================================
# OPTIONAL - Defaults work for most cases
# ==============================================================================

# ClickHouse MCP Server (default: public demo database with 35+ datasets)
CLICKHOUSE_HOST=sql-clickhouse.clickhouse.com
CLICKHOUSE_USER=demo
CLICKHOUSE_PASSWORD=

# LLM Models
ANTHROPIC_MODEL=claude-sonnet-4-20250514
EVALUATOR_MODEL=claude-3-5-haiku-20241022
TEMPERATURE=0.7

# Service Ports
TEXT_TO_SQL_PORT=8002
VECTOR_RAG_PORT=8003

# Langfuse connection settings
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PORT=3001

# ==============================================================================
# INTERNAL - Usually don't need to change
# ==============================================================================

# MongoDB (LibreChat data storage)
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Meilisearch (full-text search)
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=DrhYf7zENyR6AlUCKmnz0eYASOQdl6zxH7s7MKFSfFCt

# LibreChat settings
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
CONSOLE_JSON=true
DEBUG_CONSOLE=true
