# ==============================================================================
# LLM Observability Demo - Environment Configuration
# ==============================================================================
#
# Quick Start:
#   1. Copy this file: cp .env.example .env
#   2. Add your ANTHROPIC_API_KEY below
#   3. Run: ./setup.sh
#
# The setup script will:
#   - Auto-generate LibreChat secrets (if missing)
#   - Start all services with Langfuse auto-provisioned
#   - Detect and reuse already-running services
#
# ==============================================================================

# ==============================================================================
# DEPLOYMENT MODE - Choose how Langfuse runs
# ==============================================================================
# cloud:       Use Langfuse Cloud (https://cloud.langfuse.com) — fewer containers,
#              sign up free, get keys from Settings > API Keys
# self-hosted: Run Langfuse locally via Docker (default, ~12 containers)
DEPLOY_MODE=self-hosted

# ==============================================================================
# REQUIRED - Must be set before running ./setup.sh
# ==============================================================================

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ==============================================================================
# LANGFUSE - Pre-configured for auto-provisioned demo project
# ==============================================================================
# These match the headless init config in docker-compose.yaml.
# Langfuse auto-creates a demo project with these keys on first boot.
#
# Cloud mode: Replace with your Langfuse Cloud keys from Settings > API Keys.
# Self-hosted: Keep defaults — setup.sh auto-provisions a demo project.

LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_BASE_URL=http://localhost:3001

# LANGFUSE_HOST is auto-derived from LANGFUSE_BASE_URL by setup.sh.
# Used by the Langfuse CLI and some SDKs.
# LANGFUSE_HOST=

# LANGFUSE_INTERNAL_URL is set by setup.sh for Docker containers.
# Cloud mode: set to LANGFUSE_BASE_URL so containers reach cloud Langfuse.
# Self-hosted: left unset so docker-compose.yaml falls back to http://langfuse-web:3000.
# LANGFUSE_INTERNAL_URL=

# Langfuse Enterprise license key (unlocks EE features; omit for community edition)
# LANGFUSE_EE_LICENSE_KEY=

# Model used by the auto-provisioned LLM-as-a-Judge evaluators
# (scripts/seed-llm-judge-evaluators.sh). Haiku keeps eval cost low.
# LANGFUSE_EVAL_MODEL=claude-haiku-4-5-20251001

# ==============================================================================
# AUTO-GENERATED - Created by ./setup.sh on first run
# ==============================================================================
# These values are generated automatically during setup.
# Only set manually if you need specific values.

# LibreChat Secrets (auto-generated with openssl)
# CREDS_KEY=
# CREDS_IV=
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# Langfuse MCP Auth Token (auto-derived from public/secret keys)
# LANGFUSE_MCP_AUTH_TOKEN=

# ==============================================================================
# OPTIONAL - Defaults work for most cases
# ==============================================================================

# ClickHouse MCP Server (default: public demo database with 35+ datasets)
# Cloud alternative: Use your own ClickHouse Cloud instance
#   Sign up at https://clickhouse.cloud (free tier available)
CLICKHOUSE_HOST=sql-clickhouse.clickhouse.com
CLICKHOUSE_USER=demo
CLICKHOUSE_PASSWORD=

# LLM Models
ANTHROPIC_MODEL=claude-sonnet-4-6
TEMPERATURE=0.7

# Service Ports
TEXT_TO_SQL_PORT=8002
VECTOR_RAG_PORT=8003
LANGFUSE_PORT=3001
DASHBOARD_PORT=8005
AGENTIC_RAG_PORT=8006
MCP_RAG_RETRIEVER_PORT=8007
# Dedicated ClickHouse (26.3) for the Agentic RAG native vector store
CLICKHOUSE_VECTORS_HTTP_PORT=8125

# Dashboard Settings
DASHBOARD_CACHE_TTL=60

# ==============================================================================
# INTERNAL - Usually don't need to change
# ==============================================================================

# MongoDB (LibreChat data storage)
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Meilisearch (full-text search)
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=DrhYf7zENyR6AlUCKmnz0eYASOQdl6zxH7s7MKFSfFCt

# LibreChat settings
ALLOW_REGISTRATION=true
