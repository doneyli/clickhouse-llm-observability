# ==============================================================================
# LLM Observability Demo - Environment Configuration
# ==============================================================================
#
# Quick Start:
#   1. Copy this file: cp .env.example .env
#   2. Add your ANTHROPIC_API_KEY below
#   3. Run: ./setup.sh
#
# The setup script will:
#   - Auto-generate LibreChat secrets (if missing)
#   - Start all services with Langfuse auto-provisioned
#   - Detect and reuse already-running services
#
# ==============================================================================

# ==============================================================================
# REQUIRED - Must be set before running ./setup.sh
# ==============================================================================

# Anthropic API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# ==============================================================================
# LANGFUSE - Pre-configured for auto-provisioned demo project
# ==============================================================================
# These match the headless init config in docker-compose.yaml.
# Langfuse auto-creates a demo project with these keys on first boot.

LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
LANGFUSE_SECRET_KEY=sk-lf-1234567890
LANGFUSE_BASE_URL=http://localhost:3001

# ==============================================================================
# AUTO-GENERATED - Created by ./setup.sh on first run
# ==============================================================================
# These values are generated automatically during setup.
# Only set manually if you need specific values.

# LibreChat Secrets (auto-generated with openssl)
# CREDS_KEY=
# CREDS_IV=
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# Langfuse MCP Auth Token (auto-derived from public/secret keys)
# LANGFUSE_MCP_AUTH_TOKEN=

# ==============================================================================
# OPTIONAL - Defaults work for most cases
# ==============================================================================

# ClickHouse MCP Server (default: public demo database with 35+ datasets)
CLICKHOUSE_HOST=sql-clickhouse.clickhouse.com
CLICKHOUSE_USER=demo
CLICKHOUSE_PASSWORD=

# LLM Models
ANTHROPIC_MODEL=claude-sonnet-4-20250514
TEMPERATURE=0.7

# Service Ports
TEXT_TO_SQL_PORT=8002
VECTOR_RAG_PORT=8003
LANGFUSE_PORT=3001

# ==============================================================================
# INTERNAL - Usually don't need to change
# ==============================================================================

# MongoDB (LibreChat data storage)
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Meilisearch (full-text search)
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=DrhYf7zENyR6AlUCKmnz0eYASOQdl6zxH7s7MKFSfFCt

# LibreChat settings
ALLOW_REGISTRATION=true
