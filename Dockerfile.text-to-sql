FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl gcc python3-dev && rm -rf /var/lib/apt/lists/*

COPY text-to-sql/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY text-to-sql/ .
COPY scripts/ /scripts/

ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default: run demo then start TruLens dashboard
CMD ["sh", "-c", "python main.py && python run_dashboard.py"]
